# Compose 变量和后端容器环境变量
#
# 默认使用外部 MySQL 服务器。填写 MySQL 所在服务器的内网 IP、域名或公网 IP。
# 例如：MYSQL_HOST=10.0.0.25 或 MYSQL_HOST=mysql.example.com
MYSQL_HOST=your-mysql-server-host
MYSQL_PORT=3306
MYSQL_DATABASE=ry-vue
MYSQL_USERNAME=wms
MYSQL_PASSWORD=change-this-db-password
# 仅启用 local-db profile 时需要，外部 MySQL 可留空
MYSQL_ROOT_PASSWORD=change-this-root-password

# 如果 MySQL 就安装在当前 WMS 宿主机上，填写 localhost。
# MYSQL_HOST=localhost

# 只有启用 Compose 的 local-db profile 时，才填写 mysql：
# docker compose --profile local-db --env-file .env.docker up -d
# MYSQL_HOST=mysql

# Redis 仅在 Docker 内网开放，不映射到宿主机
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 必须替换为随机长字符串
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32

# 可选：AI 助手密钥
WMS_AI_API_KEY=

# 自动备份：每天 03:00 执行，默认保留 7 天
BACKUP_HOUR=3
BACKUP_MINUTE=0
BACKUP_RETENTION_DAYS=7
BACKUP_RUN_ON_START=false
