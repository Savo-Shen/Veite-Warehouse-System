# Compose 变量和后端容器环境变量
#
# 默认使用外部 MySQL 服务器。填写 MySQL 所在服务器的内网 IP、域名或公网 IP。
# 例如：MYSQL_HOST=10.0.0.25 或 MYSQL_HOST=mysql.example.com
MYSQL_HOST=your-mysql-server-host
MYSQL_PORT=3306
MYSQL_DATABASE=ry-vue
MYSQL_USERNAME=wms
MYSQL_PASSWORD=change-this-db-password
# 仅启用 local-db profile 时需要，外部 MySQL 可留空
MYSQL_ROOT_PASSWORD=change-this-root-password

# 如果 MySQL 就装在当前宿主机上（不在 Docker 里），【不能填 localhost】：
# 容器里的 localhost 指的是容器自己，连不到宿主机的 MySQL。要填：
#   Windows / macOS 的 Docker Desktop：MYSQL_HOST=host.docker.internal
#   Linux：填宿主机内网 IP，例如 MYSQL_HOST=192.168.1.10
# 同时宿主机 MySQL 的 bind-address 不能只绑 127.0.0.1，账号也要授权给 Docker 网段。
# MYSQL_HOST=host.docker.internal

# 只有启用 Compose 的 local-db profile 时，才填写 mysql：
# docker compose --profile local-db --env-file .env.docker up -d
# MYSQL_HOST=mysql

# Redis 仅在 Docker 内网开放，不映射到宿主机
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 必须替换为随机长字符串（openssl rand -hex 32）。
# 应用启动时会校验：为空、仍是这个示例值、或短于 32 字符，都会直接启动失败。
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32

# 可选：AI 助手密钥
WMS_AI_API_KEY=

# ===== 自动备份 =====
# Docker 部署下有两套自动备份，只应启用其中一套，否则会重复备份并互相清理：
#
# (A) Compose 的 wms-db-backup 容器（下面这几项）。
# (B) 后端应用内置的自动备份（WMS_BACKUP_* 系列，见下）。
#
# 默认沿用 (A)。若改用 (B)，请把 wms-db-backup 服务停掉，并设置 WMS_BACKUP_ENABLED=true。
# 推荐改用 (B)：备份计划能在后台页面上直接改、失败能在页面上看到，(A) 只能改文件重启容器。
BACKUP_HOUR=3
BACKUP_MINUTE=0
BACKUP_RETENTION_DAYS=7
BACKUP_RUN_ON_START=false

# 应用内置自动备份。Docker 下默认关闭，避免和 wms-db-backup 容器重复。
WMS_BACKUP_ENABLED=false
# 备份目录。留空则用 /app/backups（已挂载到 wms_backend_backups 卷）。
# WMS_BACKUP_DIR=/app/backups
# 离机副本目录，需要额外挂载后再填写。
# WMS_BACKUP_MIRROR_DIR=
# WMS_BACKUP_INTERVAL_HOURS=24
# WMS_BACKUP_RETENTION_DAYS=14
# WMS_BACKUP_MIN_KEEP=3
# mysqldump 路径。后端镜像里已装 default-mysql-client，一般不用填。
# WMS_BACKUP_MYSQLDUMP=
