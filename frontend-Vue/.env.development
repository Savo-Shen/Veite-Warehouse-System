# 页面标题
VITE_APP_TITLE = 威特仓库管理系统

# 开发环境配置
VITE_APP_ENV = 'development'

# 若依管理系统/开发环境
# VITE_APP_BASE_API = 'http://cangku.ichengle.top/prod-api'
VITE_APP_BASE_API = '/dev-api'

# 应用访问路径 例如使用前缀 /admin/
VITE_APP_CONTEXT_PATH = '/'

# 监控地址
VITE_APP_MONITRO_ADMIN = 'http://localhost:9090/admin/applications'

# xxl-job 控制台地址
VITE_APP_XXL_JOB_ADMIN = 'http://localhost:9100/xxl-job-admin'

# 高德地图 JS API —— 仅作兜底，推荐在系统内「基础资料 → 环境配置」页面配置（存 sys_config，改完刷新即生效，无需重新打包）
# 如需在此配置：https://console.amap.com/dev/key/app 申请「Web端(JS API)」类型 Key，真实 Key 建议写入 .env.local（已被 .gitignore 忽略）
VITE_AMAP_KEY = ''
VITE_AMAP_SECURITY_CODE = ''
