# 页面标题
VITE_APP_TITLE = 威特仓库管理系统

# 生产环境配置
VITE_APP_ENV = 'production'

# 应用访问路径 例如使用前缀 /admin/
VITE_APP_CONTEXT_PATH = '/'

# 监控地址
VITE_APP_MONITRO_ADMIN = '/admin/applications'

# 监控地址
VITE_APP_XXL_JOB_ADMIN = '/xxl-job-admin'

# 若依管理系统/生产环境
VITE_APP_BASE_API = '/prod-api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

# 高德地图 JS API —— 仅作兜底，推荐在系统内「基础资料 → 环境配置」页面配置（存 sys_config，改完刷新即生效，无需重新打包）
# 如需在此配置：https://console.amap.com/dev/key/app 申请「Web端(JS API)」类型 Key，真实 Key 建议写入 .env.local（已被 .gitignore 忽略）
VITE_AMAP_KEY = ''
VITE_AMAP_SECURITY_CODE = ''
