# 复制本文件为 backend/.env 并填入真实值；.env 已被 .gitignore 忽略，不会提交。
# 运行 dev-start.sh 会自动加载 backend/.env。

# ===== 数据库 =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ry-vue
MYSQL_USERNAME=your_db_user
MYSQL_PASSWORD=your_db_password

# ===== JWT 秘钥（请改为随机长字符串，例如 openssl rand -hex 32 的结果）=====
JWT_SECRET_KEY=please_change_me_to_a_long_random_string

# ===== AI 助手（new-api 网关密钥）=====
WMS_AI_API_KEY=sk-your-new-api-key

# ===== 数据库自动备份 =====
# 注意：下面这些只是「数据库里还没有设置时的初始值」。
# 系统跑起来之后，备份计划请在后台「基础资料 → 数据库备份」页面里改，改完立即生效、不用重启。
#
# 需要 mysqldump（MySQL 自带）。找不到时系统会自动去常见安装目录找一遍，
# 仍找不到就在备份页面的「mysqldump 路径」里填绝对路径，或用下面的 WMS_BACKUP_MYSQLDUMP。
WMS_BACKUP_ENABLED=true
# WMS_BACKUP_MYSQLDUMP=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe
# 备份目录。不填会落在启动目录下的 backups\，建议指定一个绝对路径，最好和数据库不在同一块硬盘。
# WMS_BACKUP_DIR=D:\wms-backups
# 离机副本目录。指向网盘同步盘或移动硬盘，每次备份完成后自动复制一份。
# 强烈建议配置：备份和数据库在同一块硬盘上时，硬盘坏了会一起丢失。
# WMS_BACKUP_MIRROR_DIR=C:\Users\你的用户名\OneDrive\wms-backups
# 距上次备份超过多少小时就自动备份一次
WMS_BACKUP_INTERVAL_HOURS=24
# 保留天数，0 表示不清理
WMS_BACKUP_RETENTION_DAYS=14
# 无论多旧都至少保留的份数
WMS_BACKUP_MIN_KEEP=3

# ===== 手动同步到云端数据库（script/sync-to-cloud.ps1 / .sh 使用）=====
# 单向覆盖：本地 -> 云端。只有手动执行脚本时才会同步，系统运行期间不会自动写云端。
# CLOUD_MYSQL_HOST=your-cloud-server-host
# CLOUD_MYSQL_PORT=3306
# 不填则与本地 MYSQL_DATABASE 同名
# CLOUD_MYSQL_DATABASE=ry-vue
# CLOUD_MYSQL_USERNAME=wms
# CLOUD_MYSQL_PASSWORD=your_cloud_db_password
# 数据要走公网，默认强制 TLS。云端没配证书时才改成 PREFERRED，但那样数据是明文传输的。
# CLOUD_MYSQL_SSL_MODE=REQUIRED
