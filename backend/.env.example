# 复制本文件为 backend/.env 并填入真实值；.env 已被 .gitignore 忽略，不会提交。
# 运行 dev-start.sh 会自动加载 backend/.env。

# ===== 数据库 =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ry-vue
MYSQL_USERNAME=your_db_user
MYSQL_PASSWORD=your_db_password

# ===== JWT 秘钥（请改为随机长字符串，例如 openssl rand -hex 32 的结果）=====
JWT_SECRET_KEY=please_change_me_to_a_long_random_string

# ===== AI 助手（new-api 网关密钥）=====
WMS_AI_API_KEY=sk-your-new-api-key
