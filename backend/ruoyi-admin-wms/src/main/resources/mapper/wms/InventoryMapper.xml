<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.wms.mapper.InventoryMapper">

    <resultMap id="inventoryVoMap" type="com.ruoyi.wms.domain.vo.InventoryVo">
        <association property="itemSku" javaType="com.ruoyi.wms.domain.vo.ItemSkuVo">
            <id property="id" column="sku_id"/> <!-- 映射 itemSku 的 id -->
        </association>
        <association property="item" javaType="com.ruoyi.wms.domain.vo.ItemVo">
            <id property="id" column="item_id"/> <!-- 映射 item 的 id -->
        </association>
        <association property="location" javaType="com.ruoyi.wms.domain.vo.LocationVo">
            <id property="id" column="location_id"/> <!-- 映射 location 的 id -->
            <result property="locationName" column="location_name"/>
            <result property="locationCode" column="location_code"/>
        </association>
    </resultMap>

    <sql id="selectVoListByBo">
        select
        inventory.*,
        sku.id as sku_id,
        sku.*,
        item.id as item_id,
        item.*, 
        loc.id as location_id, 
        loc.location_name, 
        loc.location_code
        from wms_inventory inventory
        inner join wms_item_sku sku on inventory.sku_id=sku.id
        inner join wms_item item on sku.item_id=item.id
        left join wms_item_brand brand on item.item_brand = brand.id
        left join wms_location loc on sku.item_location_id = loc.id
        <where>
            <if test="(bo.itemName != null and bo.itemName != '')
                or (bo.itemCode != null and bo.itemCode != '')
                or (bo.skuName != null and bo.skuName != '')
                or (bo.skuCode != null and bo.skuCode != '')
                or (bo.itemCategory != null)
                or (bo.itemBrand != null)
                or (bo.itemId != null)
                or (bo.warehouseId != null)
                or (bo.minQuantity != null)
                or (bo.maxQuantity != null)
                or (bo.tagId != null)
                or (bo.itemLocationId != null)">
                <if test="bo.itemName != null and bo.itemName != ''">
                    item.item_name like concat('%', #{bo.itemName}, '%')
                </if>
                <if test="bo.itemCode != null and bo.itemCode != ''">
                    and item.item_code like concat('%', #{bo.itemCode}, '%')
                </if>
                <if test="bo.skuName != null and bo.skuName != ''">
                    and sku.sku_name like concat('%', #{bo.skuName}, '%')
                </if>
                <if test="bo.skuCode != null and bo.skuCode != ''">
                    and sku.sku_code like concat('%', #{bo.skuCode}, '%')
                </if>
                <if test="bo.itemCategory != null">
                    and item.item_category=#{bo.itemCategory}
                </if>
                <if test="bo.itemBrand != null">
                    and item.item_brand=#{bo.itemBrand}
                </if>
                <if test="bo.itemId != null">
                    and item.id=#{bo.itemId}
                </if>
                <if test="bo.warehouseId != null">
                    and inventory.warehouse_id=#{bo.warehouseId}
                </if>
                <if test="bo.minQuantity != null">
                    and inventory.quantity>=#{bo.minQuantity}
                </if>
                <if test="bo.maxQuantity != null">
                    and inventory.quantity &lt;= #{bo.maxQuantity}
                </if>
                <if test="bo.tagId != null">
                    and exists (
                        select 1 from wms_item_tag_rel rel
                        where rel.item_id = item.id and rel.tag_id = #{bo.tagId}
                    )
                </if>
                <if test="bo.itemLocationId != null">
                    and loc.id = #{bo.itemLocationId}
                </if>
            </if>
        <if test="itemKeywordGroups != null and itemKeywordGroups.size() > 0">
            <foreach collection="itemKeywordGroups" item="group">
                and (
                <foreach collection="group" item="word" separator=" or ">
                    item.item_name like concat('%', #{word}, '%')
                    or item.item_code like concat('%', #{word}, '%')
                    <!-- 品牌已从商品名称里拆出来单独存，按品牌名搜索要走品牌表 -->
                    or brand.brand_name like concat('%', #{word}, '%')
                    or sku.sku_name like concat('%', #{word}, '%')
                    or sku.sku_code like concat('%', #{word}, '%')
                    or sku.barcode like concat('%', #{word}, '%')
                    or loc.location_code like concat('%', #{word}, '%')
                </foreach>
                )
            </foreach>
        </if>
        </where>
    </sql>

    <select id="queryWarehouseBoardList" resultMap="inventoryVoMap">
        <include refid="selectVoListByBo"/>
        <choose>
            <when test="bo.sortMode == 'quantityAsc'">
                order by inventory.warehouse_id,inventory.quantity asc,sku.item_id,sku.id
            </when>
            <when test="bo.sortMode == 'quantityDesc'">
                order by inventory.warehouse_id,inventory.quantity desc,sku.item_id,sku.id
            </when>
            <otherwise>
                order by inventory.warehouse_id,sku.item_id,sku.id
            </otherwise>
        </choose>
    </select>

    <select id="queryItemBoardList" resultMap="inventoryVoMap">
        <include refid="selectVoListByBo"/>
        <choose>
            <when test="bo.sortMode == 'quantityAsc'">
                order by inventory.quantity asc,sku.item_id,sku.id,inventory.warehouse_id
            </when>
            <when test="bo.sortMode == 'quantityDesc'">
                order by inventory.quantity desc,sku.item_id,sku.id,inventory.warehouse_id
            </when>
            <otherwise>
                order by sku.item_id,sku.id,inventory.warehouse_id
            </otherwise>
        </choose>
    </select>

    <select id="queryExportList" resultMap="inventoryVoMap">
        <include refid="selectVoListByBo"/>
        order by sku.item_id,sku.id,inventory.warehouse_id
    </select>
</mapper>
